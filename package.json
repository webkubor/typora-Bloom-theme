{
  "name": "typora-bloom-theme",
  "private": true,
  "version": "1.7.1",
  "homepage": "https://bloom.webkubor.online",
  "scripts": {
    "build": "node scripts/gen-site-data.js && node scripts/build-themes.js",
    "dev": "node scripts/dev-toolkit.js",
    "dev:site": "npm run build && node scripts/preview.js",
    "sync:typora": "node scripts/dev-typora.js --once",
    "dev:typora": "node scripts/dev-typora.js",
    "validate:themes": "npm run build && node scripts/validate-theme-standard.js",
    "package": "node scripts/package.js",
    "deploy": "npm run build && node scripts/pages.js && npx wrangler pages deploy _pages --project-name=typora-bloom-theme"
  }
}
